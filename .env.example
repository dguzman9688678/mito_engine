# MITO Engine Environment Configuration
# Copy this file to .env and configure your settings

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# Primary Database (SQLite - Default)
DATABASE_URL=sqlite:///mito_unified.db

# MongoDB (Optional - for advanced features)
MONGODB_URI=mongodb://localhost:27017/mito_engine
# For MongoDB Atlas:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/mito_engine

# PostgreSQL (Optional - for production)
PGDATABASE=mito_engine
PGHOST=localhost
PGUSER=mito_user
PGPASSWORD=your_postgres_password
PGPORT=5432

# ============================================================================
# FLASK CONFIGURATION
# ============================================================================

FLASK_ENV=development
DEBUG=True

# Generate secure keys with: python -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=change-me-to-a-random-32-byte-hex-string
SESSION_SECRET=change-me-to-another-random-32-byte-hex-string

# Server Configuration
HOST=0.0.0.0
PORT=5000

# ============================================================================
# AI PROVIDER CONFIGURATION
# ============================================================================

# Default AI Provider (options: openai, llama, claude, local)
MODEL_PROVIDER=local

# OpenAI API
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL_NAME=gpt-3.5-turbo

# LLaMA via Groq
GROQ_API_KEY=your-groq-api-key-here
LLAMA_API_KEY=your-groq-api-key-here
LLAMA_API_URL=https://api.groq.com/openai/v1
LLAMA_MODEL_NAME=llama-3-70b-8192

# Anthropic Claude
ANTHROPIC_API_KEY=your-anthropic-api-key-here
CLAUDE_API_KEY=your-anthropic-api-key-here
CLAUDE_MODEL_NAME=claude-3-opus-20240229

# ============================================================================
# AUTHENTICATION & SECURITY
# ============================================================================

# Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeThisToASecurePassword123!

# Session Configuration
SESSION_COOKIE_SECURE=False  # Set to True in production with HTTPS
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME=3600  # 1 hour in seconds

# Security Settings
CSRF_ENABLED=True
WTF_CSRF_ENABLED=True

# ============================================================================
# RATE LIMITING
# ============================================================================

# Rate Limit Configuration
RATELIMIT_STORAGE_URL=memory://
RATELIMIT_DEFAULT=200 per day;50 per hour

# ============================================================================
# EMAIL CONFIGURATION (Optional)
# ============================================================================

MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-specific-password

# ============================================================================
# EXTERNAL SERVICES (Optional)
# ============================================================================

# Redis (for caching and sessions)
REDIS_URL=redis://localhost:6379/0

# Notion Integration
NOTION_TOKEN=your-notion-integration-token

# SendGrid (for emails)
SENDGRID_API_KEY=your-sendgrid-api-key

# Twilio (for SMS)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=your-twilio-phone-number

# Slack Integration
SLACK_BOT_TOKEN=your-slack-bot-token
SLACK_WEBHOOK_URL=your-slack-webhook-url

# ============================================================================
# LOGGING & MONITORING
# ============================================================================

LOG_LEVEL=INFO
LOG_FILE=mito_engine.log

# Sentry (Error Tracking)
SENTRY_DSN=your-sentry-dsn

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Enable/Disable Features
ENABLE_MONGODB=False
ENABLE_REDIS=False
ENABLE_NOTIFICATIONS=True
ENABLE_AI_GENERATION=True
ENABLE_FILE_UPLOAD=True
ENABLE_CODE_GENERATION=True

# ============================================================================
# DEVELOPMENT SETTINGS
# ============================================================================

# Testing
TESTING=False
TEST_DATABASE_URL=sqlite:///test_mito.db

# Debug Features
EXPLAIN_TEMPLATE_LOADING=False
PROPAGATE_EXCEPTIONS=True

# ============================================================================
# PRODUCTION SETTINGS
# ============================================================================

# When deploying to production, update:
# 1. FLASK_ENV=production
# 2. DEBUG=False
# 3. Generate new SECRET_KEY and SESSION_SECRET
# 4. Set SESSION_COOKIE_SECURE=True (requires HTTPS)
# 5. Configure production database
# 6. Add real API keys
# 7. Set up proper logging and monitoring
# 8. Configure rate limiting with Redis
# 9. Enable CSRF protection
# 10. Set up backup and disaster recovery

# ============================================================================
# NOTES
# ============================================================================

# - Never commit .env file to version control
# - Use different values for development and production
# - Store sensitive data securely
# - Rotate secrets regularly
# - Use environment-specific configurations
# - Review security settings before production deployment
